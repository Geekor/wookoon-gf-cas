# wookoon cas config
wookooncas:
  endpoint: "https://cas.example.com"
  clientId: ""
  clientSecret: ""
  organization: ""
  application: ""
  certificateFile: "manifest/config/certs/casdoor.pem"
  jwt:
    secret: "your-super-secret-key-at-least-32-characters"
    expires: 120            # accessToken 有效期（分钟），即空闲超时，默认 2 小时
    refreshExpires: 2880    # refreshToken 有效期（分钟），即绝对会话上限，默认 48 小时
    issuer: "wookoon-cas"